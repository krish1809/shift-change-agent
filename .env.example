# Copy to .env (gitignored). Never commit real keys.
ENV=dev
DATABASE_URL=postgresql://shift:shift@db:5432/shift
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_MINUTES=480

# LLM: groq (primary, fastest) | gemini | fake | rule_based
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=            # copy a current tool-calling model id from console.groq.com (e.g. a Llama/GPT-OSS 70B-class or 8B "instant" model)
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_API_KEY=
GEMINI_MODEL=          # copy a current Flash / Flash-Lite model id from Google AI Studio
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_FALLBACK_PROVIDER=gemini

LLM_TIMEOUT_MS=3000
MAX_LLM_CALLS_PER_TURN=4
TOOL_TIMEOUT_MS=1000
TURN_DEADLINE_MS=8000
THREAD_LOCK_WAIT_MS=2000
SWEEPER_INTERVAL_S=15

SEED_ON_START=if_empty   # if_empty | always | never  (if_empty keeps pending approvals across restarts)
SEED_BASE_DATE=        # empty = today (Asia/Kolkata)
CLOCK_OVERRIDE=        # e.g. 2026-11-20T17:30:00+05:30 for recording the cut-off demo
FAULTS=                # e.g. check_cab_options=timeout
LOG_LEVEL=INFO
